        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Rojo" android:id="@+id/red"/>
        <Button android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Verde" android:id="@+id/green"/>
